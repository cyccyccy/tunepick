# 复制为 .env 后填写（本地开发用；Docker 部署请用 docker-compose.yml 的 environment 段）
# ⚠️ 含密钥，已在 .gitignore 中忽略，切勿提交

# ---- 服务 ----
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=info

# ---- 数据源 ----
# local-fs  = 直读挂载的音乐目录（生产）
# navidrome = 走 Subsonic API（本地开发/回退）
SOURCE_KIND=localfs
MUSIC_DIR=/music
DATA_DIR=./data

# Navidrome 回退源（SOURCE_KIND=navidrome 时需要）
NAVIDROME_URL=http://100.82.120.125:4533
NAVIDROME_USER=
NAVIDROME_PASS=

# ---- 鉴权（PRD FR-79）----
# 为空时服务仅允许 127.0.0.1 访问，并在 Web 界面顶部告警
AUTH_TOKEN=
# Web 管理界面独立鉴权（与 API Token 分离，PRD FR-78）
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---- 在线刮削源 ----
# ⚠️ 唯一开关是 ONLINE_SOURCES（逗号分隔）。不存在 NETEASE_ENABLED / MUSICBRAINZ_ENABLED
#    / CAA_ENABLED 这类单独变量，写了也不生效。
# MusicBrainz 对中文曲库实测命中仅 28~33%，去掉可把全库 L2 从 ~5h 压到 ~45min
ONLINE_SOURCES=netease,caa
# 总开关：false = 完全不访问外网（纯本地 L1 模式）
ONLINE_ENABLED=true

# ---- LLM（L3：流派/情绪/场景的唯一来源）----
# 未配置 Key 时自动降级为只跑 L1+L2（PRD 要求优雅降级）
LLM_ENABLED=true
LLM_PROVIDER=deepseek
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_API_KEY=
# ⚠️ 推理模型（deepseek-flash / v4-pro）会先把 token 消耗在推理上，
#    预算不足时 content 为空导致打标失败。务必给足，实测 16384 安全。
LLM_MODEL=deepseek-flash
LLM_MAX_TOKENS=16384
LLM_BATCH_SIZE=8
LLM_TIMEOUT_MS=120000

# ---- 封面 ----
COVER_THUMB_SIZES=300
COVER_CACHE_MAX_MB=500

# ---- SqMusic 在线搜歌下载（可选集成）----
# 依赖 NAS 上已部署的 SqMusic 服务；未部署时保持 false，页面显示启用引导，不影响其他功能
SQ_ENABLED=false
# 与 SqMusic 同 docker 网络 → 填容器名；SqMusic 在宿主上 → 填宿主 IP（如 http://192.168.2.107:8099）
SQ_BASE_URL=http://sqmusic_main:8099
SQ_USERNAME=admin
SQ_PASSWORD=admin
# 可用音源：kw(酷我) / kg(酷狗) / qq / netease
SQ_PLUGINS=kw,kg,qq,netease
# 留空 = 由 SqMusic 自动选最高码率
SQ_BR_TYPE=
# 下载任务成功后自动触发一次增量扫描入库
SQ_AUTO_SCAN=true

# ---- 定时增量扫描（2026-11-04 新增）----
# 让「在 NAS 上直接删歌」无需手动点扫描也能自动清理曲库残留；
# 每次扫描都会先做完整枚举 + 删除对账，再走增量过滤。
# 关闭后仍可用 fnOS 计划任务 curl -X POST /api/scan/start 触发。
SCAN_SCHEDULE_ENABLED=true
# 扫描间隔（分钟），默认 15；只在 SOURCE_KIND=localfs 时生效
SCAN_SCHEDULE_INTERVAL_MIN=15
# 启动后延迟首跑（秒），避开容器刚拉起时的挂载抖动；0 = 立即
SCAN_SCHEDULE_BOOT_DELAY_SEC=60

# ---- 目录推断（L1-b）----
# 实测与内嵌标签同源、零新增增益，仅作校验用；扁平目录会自动优雅降级
PATH_INFER_ENABLED=true
PATH_INFER_MIN_DEPTH=2
